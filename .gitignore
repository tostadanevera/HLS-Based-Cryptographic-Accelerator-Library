# ============================================================
# Vitis HLS project artifacts
# ============================================================
# Solution folders (csim, csynth, sim, impl) are fully regenerable
# from the .cpp/.h sources and hls_config.cfg; they are large
# (typically hundreds/thousands of files per algorithm) and should
# never be committed.
.autopilot/
**/.autopilot/
**/*.autopilot/db/
hls_*/*
*_hls/*
!hls_*/hls_config.cfg
!*_hls/hls_config.cfg
**/hls_*/solution*/
**/*_hls/solution*/
*.adb
*.bc
*.bind.adb
*.bind.rtl.rpt
*.compgen.tcl
*.compgen.dataonly.tcl
*.sched.adb
*.tbgen.tcl
*.verbose.rpt
*.verbose.bind.rpt
*.verbose.sched.rpt
*ap_header*.txt
*.diag.yml
*.opt.log
*.lto.bc
vitis_hls.log
vitis_hls*.jou
.Xilinx/
*.protoinst

# ============================================================
# Vivado project artifacts
# ============================================================
# Everything below is regenerated by re-running the block design
# and Generate Bitstream; only the .xpr (project pointer) and the
# hand-written Tcl/constraints, if any, are worth versioning.
*.cache/
_ide
*.hw/
*.ip_user_files/
*.gen/
*.sim/
*.runs/
*.srcs/*/ip/
.Xil/
vivado*.log
vivado*.jou
vivado*.str
webtalk*.log
webtalk*.jou
*.dcp
*.mmi
*.bit.bak
NA_vivado_pid*.str
usage_statistics_webtalk.html
usage_statistics_webtalk.xml
fsm_encoding.os

# Keep the final, current-version bitstreams and hardware handoff
# files referenced in Chapter 6, even though they live under
# reports/ or a similar tracked directory; everything else
# Vivado regenerates under *.runs/ and *.gen/ above is excluded.
# (No blanket *.bit / *.hwh exclusion here on purpose: see reports/.)

# ============================================================
# Python / PYNQ / Jupyter
# ============================================================
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
venv/
.venv/

# ============================================================
# C++ build artifacts (software testbenches, Makefile)
# ============================================================
build/
*.o
*.obj
# Compiled test binaries (no extension) produced by the Makefile;
# the corresponding *.cpp sources are kept via the negation below.
test_*
!test_*.cpp
!test_*.py

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ============================================================
# LaTeX build artifacts (thesis document, if kept in-repo)
# ============================================================
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.json